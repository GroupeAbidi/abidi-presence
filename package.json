{
  "name": "abidi-presence-ar",
  "version": "1.3.0",
  "description": "نظام الحضور والمناوبات لشركات المجموعة - يعمل محليًا بالعربية",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis",
    "dist:win32": "electron-builder --win nsis --ia32"
  },
  "dependencies": {
    "electron-updater": "6.1.8",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dz.groupeabidi.presence",
    "productName": "حضور المجموعة",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "publish": [{
      "provider": "github",
      "owner": "GroupeAbidi",
      "repo": "abidi-presence"
    }]
  },
  "engines": {
    "node": ">=22"
  }
}
